# Copy to .env (git-ignored) and fill in ONE provider. Used to read opportunities from email.

# OpenAI, or any OpenAI-compatible gateway (set the base URL for gateways)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ...or Claude: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Optional overrides
# INTERNRADAR_LLM_PROVIDER=auto        # auto | openai | anthropic
# INTERNRADAR_LLM_MODEL=gpt-5.4-mini   # default: gpt-5.4-mini (OpenAI), claude-opus-5 (Claude)
